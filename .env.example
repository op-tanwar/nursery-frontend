# ======================================================================
# 🌐 AUTHORITATIVE PRODUCTION SITE URL (SEO, Sitemaps, JSON-LD, Canonicals)
# ======================================================================
NEXT_PUBLIC_SITE_URL=https://urbannursery-neon.vercel.app
ENABLE_CUSTOM_DOMAIN_REDIRECT=false

# ======================================================================
# 📡 BACKEND API ENDPOINT
# ======================================================================
# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ======================================================================
# 💳 PAYMENT GATEWAY (RAZORPAY)
# ======================================================================
# Razorpay Key ID (Client-side Public Key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# ======================================================================
# 🔑 OAUTH 2.0 AUTHENTICATION (GOOGLE)
# ======================================================================
# ⚠️ CRITICAL SECURITY GUARD: NEVER PUT GOOGLE CLIENT SECRET IN FRONTEND CONFIG
# OAuth client secrets must strictly reside on the backend server (planto-backend/.env).
# Frontend only requires the public Client ID prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ======================================================================
# 🌍 ENVIRONMENT
# ======================================================================
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
